# Copy to .env (the installer does this for you). Never commit .env — it holds secrets.

# --- Public access (VPS tier) ---
# sslip.io needs no DNS: replace dots with dashes in your server IP.
# e.g. IP 44.127.82.12  ->  DOMAIN=44-127-82-12.sslip.io
DOMAIN=

# --- Login (protects the public dashboard) ---
BASIC_USER=admin
# bcrypt hash, NOT the plaintext password. Generate:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
BASIC_HASH=

# --- Hermes agent (only if you enabled the "agent" profile) ---
# Model access via OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# NOTE: Telegram is NOT set here. Hermes pairs Telegram interactively via
# `hermes setup` (it stores the connector itself). After the box is up, run:
#   docker compose exec hermes hermes setup
# and follow the Telegram pairing step once.
