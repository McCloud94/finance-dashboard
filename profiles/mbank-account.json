{
  "name": "mbank-account",
  "label": "mBank current account (SK export)",
  "account": "mbank",
  "encoding": "utf-8",
  "match": {
    "headers_all": [
      "#Dátum zaúčtovania transakcie",
      "#Popis operácie",
      "#Platca/Príjemca",
      "#Suma transakcie"
    ]
  },
  "columns": {
    "date": { "col": "#Dátum zaúčtovania transakcie", "format": "%d-%m-%Y" },
    "name": { "coalesce": ["#Platca/Príjemca", "#Popis operácie"] },
    "merchant": { "col": "#Platca/Príjemca" },
    "amount": { "col": "#Suma transakcie", "decimal": ",", "sign": "native" }
  },
  "rules": [
    {
      "match": "splatenie kreditnej karty",
      "direction": "internal",
      "transfer_to": "mcredit",
      "name": "Credit card payback",
      "note": "mBank -> mCredit"
    },
    {
      "match": "your name",
      "direction": "internal",
      "note": "own-account transfer"
    }
  ]
}
