{
  "name": "bybit",
  "label": "Bybit card transaction CSV",
  "account": "bybit",
  "encoding": "utf-8",
  "match": {
    "headers_all": ["Merchant Name", "Transaction Date & Time", "Total Transaction Amount"]
  },
  "columns": {
    "date": { "col": "Transaction Date & Time", "format": "%Y-%m-%d" },
    "name": { "col": "Merchant Name" },
    "merchant": { "col": "Merchant Name" },
    "amount": {
      "col": "Total Transaction Amount",
      "decimal": ".",
      "sign": "native"
    },
    "category": { "col": "Category" }
  },
  "rules": []
}
